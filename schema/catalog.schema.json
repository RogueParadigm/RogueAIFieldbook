{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rogueparadigm.com/schemas/rogue-ai-fieldbook-catalog-v1.json",
  "title": "Rogue AI Fieldbook catalog",
  "type": "object",
  "required": ["catalog_version", "entries"],
  "properties": {
    "catalog_version": { "const": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category", "status", "upstream", "license", "tested_with", "field_note"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "status": { "const": "tested" },
          "upstream": { "type": "string", "format": "uri" },
          "license": { "type": "string", "minLength": 1 },
          "tested_with": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "field_note": { "type": "string", "pattern": "^models/.+\\.md$" }
        }
      }
    }
  },
  "additionalProperties": false
}
